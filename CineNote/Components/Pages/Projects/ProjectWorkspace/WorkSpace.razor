@page "/projects/{ProjectId:int}"
@layout ProjectLayout
@rendermode InteractiveServer
@using CineNote.Models
@using CineNote.Services
@inject MovieProjectService ProjectService

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border workspace-spinner" role="status"></div>
    </div>
}
else if (project == null)
{
    <div class="text-center py-5 border rounded-3 bg-light">
        <p class="text-muted mb-0">Проект не найден.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">

        <!-- Логлайн -->
        <div class="p-4 rounded-4 bg-light border-0 shadow-sm">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark m-0">Логлайн</h5>
                    <span class="text-muted small">Главная идея фильма</span>
                </div>

                @if (!isEditingLogline)
                {
                    <button class="btn btn-sm btn-outline-dark rounded-3"
                            @onclick="StartEditingLogline">
                        <i class="bi bi-pencil me-1"></i>
                        Изменить
                    </button>
                }
            </div>

            @if (isEditingLogline)
            {
                <textarea class="form-control logline-textarea"
                          @bind="editedLogline"
                          maxlength="250"
                          rows="3"
                          placeholder="Кратко опишите основную идею фильма...">
                        </textarea>

                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">

                    <span class="text-muted small">
                        @editedLogline.Length / 250 символов
                    </span>

                    <div class="d-flex gap-2">
                        <button class="btn workspace-button"
                                @onclick="SaveLogline"
                                disabled="@isSavingLogline">
                            @(isSavingLogline ? "Сохранение..." : "Сохранить")
                        </button>

                        <button class="btn workspace-cancel-button"
                                @onclick="CancelEditingLogline"
                                disabled="@isSavingLogline">
                            Отмена
                        </button>
                    </div>

                </div>
            }
            else
            {
                <p class="text-dark fs-5 mb-0 lh-base"
                   style="white-space: pre-wrap;">
                    @(string.IsNullOrEmpty(project.Logline)
                        ? "Логлайн ещё не добавлен..."
                        : project.Logline)
                </p>
            }

            @if (!string.IsNullOrEmpty(loglineMessage))
            {
                <p class="small text-muted mt-2 mb-0">
                    @loglineMessage
                </p>
            }

        </div>

        <!-- Синопсис -->
        <div class="synopsis-section p-4 rounded-4">

            <div class="mb-3">
                <h5 class="fw-bold text-dark mb-1">Синопсис</h5>

                <p class="text-muted small mb-0">
                    Развёрнутое описание истории, событий и персонажей вашего фильма.
                </p>
            </div>

            <SynopsisEditor @key="ProjectId"
                            InitialContent="@currentSynopsis"
                            OnSave="HandleSaveSynopsis" />

        </div>

    </div>
}

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private MovieProject? project;
    private bool isLoading = true;

    private string currentSynopsis = string.Empty;

    private bool isEditingLogline;
    private bool isSavingLogline;

    private string editedLogline = string.Empty;
    private string loglineMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        project = await ProjectService.GetProjectByIdAndUserAsync(ProjectId, 1);

        if (project != null)
        {
            currentSynopsis = project.Synopsis ?? string.Empty;
        }

        isLoading = false;
    }

    // Начало редактирования логлайна
    private void StartEditingLogline()
    {
        editedLogline = project?.Logline ?? string.Empty;
        loglineMessage = string.Empty;
        isEditingLogline = true;
    }

    // Сохранение логлайна
    private async Task SaveLogline()
    {
        if (project == null)
            return;

        string logline = editedLogline.Trim();

        if (logline.Length > 250)
        {
            loglineMessage = "Логлайн не должен превышать 250 символов.";
            return;
        }

        isSavingLogline = true;
        loglineMessage = string.Empty;

        try
        {
            bool result = await ProjectService.UpdateLoglineAsync(
                ProjectId,
                1,
                logline
            );

            if (result)
            {
                project.Logline = logline;
                isEditingLogline = false;
                loglineMessage = "Логлайн сохранён.";
            }
            else
            {
                loglineMessage = "Не удалось сохранить логлайн.";
            }
        }
        catch
        {
            loglineMessage = "Ошибка при сохранении логлайна.";
        }
        finally
        {
            isSavingLogline = false;
        }
    }

    // Отмена редактирования
    private void CancelEditingLogline()
    {
        editedLogline = project?.Logline ?? string.Empty;
        isEditingLogline = false;
        loglineMessage = string.Empty;
    }

    // Сохранение синопсиса
    private async Task HandleSaveSynopsis(string updatedContent)
    {
        bool result = await ProjectService.UpdateSynopsisAsync(
            ProjectId,
            1,
            updatedContent
        );

        if (!result)
        {
            throw new Exception("Не удалось сохранить синопсис.");
        }

        currentSynopsis = updatedContent;
        project!.Synopsis = updatedContent;
    }
}
