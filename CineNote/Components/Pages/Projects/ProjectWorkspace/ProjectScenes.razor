@page "/projects/{ProjectId:int}/scenes"
@layout ProjectLayout
@using CineNote.Models
@using CineNote.Services
@inject SceneService SceneService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
        <img src="/images/icons/icon_timeline.png" alt="" width="42" height="42" style="object-fit: contain;" />
        <div>
            <h3 class="fw-bold text-dark mb-0">Сцены проекта</h3>
            <p class="text-muted small mb-0">Поэпизодный план, структурирование по актам и драматургический анализ</p>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group btn-group-sm p-1 bg-light border rounded-pill shadow-none" role="group">
            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold view-switch-btn @(isActView ? "active-view" : "text-muted")"
                    @onclick="() => isActView = true"
                    title="Сгруппировать сцены по актам с возможностью сворачивания">
                <i class="bi bi-folder2-open me-1"></i>По актам
            </button>
            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold view-switch-btn @(!isActView ? "active-view" : "text-muted")"
                    @onclick="() => isActView = false"
                    title="Отобразить все сцены сплошным сквозным списком">
                <i class="bi bi-list-ol me-1"></i>Сплошной список
            </button>
        </div>

        <button class="btn btn-warning rounded-3 px-3 py-2 fw-semibold text-dark shadow-sm" @onclick="() => OpenCreatePage()">
            <i class="bi bi-plus-lg me-1"></i> Добавить сцену
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (!scenes.Any())
{
    <div class="text-center py-5 border rounded-4 bg-light p-5">
        <div class="mb-3">
            <img src="/images/icons/icon_timeline.png" alt="" width="95" height="95" style="object-fit: contain; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.08)); opacity: 0.8;" />
        </div>
        <h5 class="fw-bold text-dark mb-1">Сцены пока не добавлены</h5>
        <p class="text-muted small mb-3">Начните создавать поэпизодный план: распределяйте сцены по актам, задавайте локации и поворотные точки.</p>
        <button class="btn btn-warning rounded-3 px-4 py-2 fw-semibold text-dark shadow-sm" @onclick="() => OpenCreatePage()">
            <i class="bi bi-plus-lg me-1"></i> Добавить первую сцену
        </button>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex flex-wrap gap-2">
                <button class="btn status-filter-btn @(currentFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
                    Все <span class="badge rounded-pill bg-light text-dark ms-1">@scenes.Count</span>
                </button>
                <button class="btn status-filter-btn @(currentFilter == "draft" ? "active" : "")" @onclick='() => SetFilter("draft")'>
                    <i class="bi bi-pencil-square me-1"></i>Черновики
                    <span class="badge rounded-pill bg-light text-dark ms-1">@DraftCount</span>
                </button>
                <button class="btn status-filter-btn @(currentFilter == "inprogress" ? "active" : "")" @onclick='() => SetFilter("inprogress")'>
                    <i class="bi bi-hourglass-split me-1 text-primary"></i>В работе
                    <span class="badge rounded-pill bg-light text-dark ms-1">@InProgressCount</span>
                </button>
                <button class="btn status-filter-btn @(currentFilter == "ready" ? "active" : "")" @onclick='() => SetFilter("ready")'>
                    <i class="bi bi-check-circle-fill me-1 text-success"></i>Готовы
                    <span class="badge rounded-pill bg-light text-dark ms-1">@ReadyCount</span>
                </button>
                <button class="btn status-filter-btn @(currentFilter == "dramatic" ? "active" : "")" @onclick='() => SetFilter("dramatic")'>
                    <i class="bi bi-diagram-3-fill me-1 text-danger"></i>Поворотные точки
                    <span class="badge rounded-pill bg-light text-dark ms-1">@DramaticCount</span>
                </button>
            </div>

            <div class="d-flex align-items-center gap-3">
                @if (isActView)
                {
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" @onclick="ToggleAllActs">
                        <i class="bi @(allActsCollapsed ? "bi-arrows-expand" : "bi-arrows-collapse") me-1"></i>
                        @(allActsCollapsed ? "Развернуть все акты" : "Свернуть все акты")
                    </button>
                }

                <div class="text-end">
                    <div class="small fw-bold text-dark">Готовность: @ReadinessPercent%</div>
                    <div class="text-muted extra-small">@ReadyCount из @scenes.Count сцен завершено</div>
                </div>
                <div class="progress rounded-pill" style="width: 110px; height: 9px; background-color: #E5E7EB;">
                    <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: @ReadinessPercent%;" aria-valuenow="@ReadinessPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>

    @if (isActView)
    {
        <div class="d-flex flex-column gap-4">
            @foreach (MovieAct act in Enum.GetValues(typeof(MovieAct)))
            {
                var actScenes = GetFilteredScenesForAct(act).ToList();
                int totalInAct = scenes.Count(s => s.Act == act);
                int readyInAct = scenes.Count(s => s.Act == act && s.Status == SceneStatus.Ready);
                int percentInAct = totalInAct > 0 ? (int)Math.Round((double)readyInAct / totalInAct * 100) : 0;
                int actShare = scenes.Any() ? (int)Math.Round((double)totalInAct / scenes.Count * 100) : 0;
                bool isCollapsed = collapsedActs.Contains(act);

                <div class="act-card rounded-4 border-0 shadow-sm bg-white overflow-hidden @(draggedScene != null && draggedScene.Act != act ? "act-drop-target-active" : "")"
                     @ondragover="OnDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="() => OnDropOnAct(act)"
                     @ondrop:stopPropagation="true">
                    <div class="act-header p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 cursor-pointer"
                         @onclick="() => ToggleAct(act)">
                        <div class="d-flex align-items-center gap-3">
                            <div class="act-badge-icon rounded-circle d-flex justify-content-center align-items-center"
                                 style="background-color: @act.ToAccentColor(); color: #ffffff;">
                                <i class="bi @act.ToIconClass() fs-6"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold text-dark mb-0 fs-6">@act.ToDisplayName()</h5>
                                    <span class="badge rounded-pill bg-light text-muted border small">
                                        @totalInAct @GetScenesWord(totalInAct) (@actShare% фильма)
                                    </span>
                                </div>
                                <div class="text-muted extra-small">@act.ToDescription()</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3" @onclick:stopPropagation="true">
                            <div class="d-none d-md-flex align-items-center gap-1">
                                @foreach (var m in GetActMarkers(act))
                                {
                                    <span class="badge @m.ToBadgeClass() rounded-pill px-2 py-1 extra-small">
                                        <i class="bi @m.ToIconClass() me-1"></i>@m.ToDisplayName()
                                    </span>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(percentInAct == 100 ? "bg-success" : (percentInAct > 0 ? "bg-primary" : "bg-secondary")) rounded-pill px-2 py-1 extra-small">
                                    @percentInAct% готово
                                </span>
                            </div>

                            <button class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 py-1 shadow-none"
                                    title="Добавить новую сцену в этот акт"
                                    @onclick="() => OpenCreatePage(act)">
                                <i class="bi bi-plus-lg me-1"></i>Сцена
                            </button>

                            <button class="btn btn-sm btn-light rounded-circle shadow-none p-1"
                                    title="@(isCollapsed ? "Развернуть акт" : "Свернуть (архивировать) акт")"
                                    @onclick="() => ToggleAct(act)">
                                <i class="bi @(isCollapsed ? "bi-chevron-down" : "bi-chevron-up") fs-6 text-muted"></i>
                            </button>
                        </div>
                    </div>

                    @if (!isCollapsed)
                    {
                        <div class="act-body p-4 pt-2 border-top">
                            @if (!actScenes.Any())
                            {
                                <div class="text-center py-4 text-muted small bg-light rounded-3 my-2 border act-empty-dropzone"
                                     @ondragover="OnDragOver"
                                     @ondragover:preventDefault="true"
                                     @ondrop="() => OnDropOnAct(act)"
                                     @ondrop:stopPropagation="true">
                                    <i class="bi bi-arrow-down-circle text-warning fs-3 d-block mb-1"></i>
                                    <span class="fw-semibold">В этом акте пока нет сцен.</span><br />
                                    <span>Перетащите сюда карточку сцены из другого акта или</span>
                                    <button class="btn btn-link btn-sm text-warning p-0 ms-1 fw-semibold text-decoration-none" @onclick="() => OpenCreatePage(act)">
                                        создайте новую сцену
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3 mt-1">
                                    @foreach (var scene in actScenes)
                                    {
                                        <div class="col-12 col-md-6 col-lg-4">
                                            <div class="card h-100 scene-card p-3 d-flex flex-column justify-content-between position-relative overflow-hidden @(draggedScene == scene ? "dragging" : "") @(dropTargetScene == scene && draggedScene != scene ? "drop-target" : "")"
                                                 draggable="true"
                                                 @onclick="() => OpenEditPage(scene)"
                                                 @ondragstart="(e) => OnDragStart(e, scene)"
                                                 @ondragend="OnDragEnd"
                                                 @ondragenter="() => OnDragEnter(scene)"
                                                 @ondragleave="() => OnDragLeave(scene)"
                                                 @ondragover="OnDragOver"
                                                 @ondragover:preventDefault="true"
                                                 @ondrop="() => OnDrop(scene)"
                                                 @ondrop:stopPropagation="true">
                                                <div class="card-accent-bar" style="@GetAccentBarStyle(scene)"></div>

                                                <div>
                                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                                            <span class="drag-handle" title="Зажмите для перетаскивания">
                                                                <i class="bi bi-grip-vertical fs-5"></i>
                                                            </span>
                                                            <span class="badge scene-num-badge rounded-pill px-3 py-1 fw-bold">
                                                                СЦЕНА @scene.SceneNumber
                                                            </span>

                                                            <select class="act-select-badge shadow-none"
                                                                    title="Переместить сцену в другой акт"
                                                                    draggable="false"
                                                                    @onclick:stopPropagation="true"
                                                                    value="@scene.Act.ToString()"
                                                                    @onchange="(e) => OnActSelectChanged(scene, e.Value)">
                                                                <option value="Act1">Акт I</option>
                                                                <option value="Act2">Акт II</option>
                                                                <option value="Act3">Акт III</option>
                                                            </select>

                                                            <button type="button" class="btn badge @scene.Status.ToBadgeClass() rounded-pill px-2 py-1 shadow-none"
                                                                    title="Нажмите для смены статуса (Черновик → В работе → Готова)"
                                                                    @onclick="() => CycleSceneStatus(scene)"
                                                                    @onclick:stopPropagation="true"
                                                                    draggable="false">
                                                                <i class="bi @scene.Status.ToIconClass() me-1"></i>@scene.Status.ToDisplayName()
                                                            </button>
                                                        </div>
                                                    </div>

                                                    @if (scene.DramaticStructure != DramaticStructure.None)
                                                    {
                                                        <div class="mb-2">
                                                            <span class="badge @scene.DramaticStructure.ToBadgeClass() rounded-pill px-2 py-1 small fw-semibold">
                                                                <i class="bi @scene.DramaticStructure.ToIconClass() me-1"></i>@scene.DramaticStructure.ToDisplayName()
                                                            </span>
                                                        </div>
                                                    }

                                                    <div class="mb-2">
                                                        @if (editingTitleSceneId == scene.Id)
                                                        {
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" class="form-control" @bind="tempTitle" @onkeyup="HandleTitleKeyUp" />
                                                                <button class="btn btn-warning text-dark" @onclick="() => SaveInlineTitle(scene)"><i class="bi bi-check-lg"></i></button>
                                                                <button class="btn btn-light" @onclick="CancelInlineTitle"><i class="bi bi-x-lg"></i></button>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <h5 class="fw-bold text-dark m-0 fs-6 text-truncate" title="@scene.DisplayTitle">
                                                                    @scene.DisplayTitle
                                                                </h5>
                                                                <button class="btn btn-sm btn-link text-muted p-0 ms-1 text-decoration-none edit-title-btn"
                                                                        title="Быстро изменить название"
                                                                        @onclick="() => StartInlineTitle(scene)"
                                                                        @onclick:stopPropagation="true"
                                                                        draggable="false">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="text-muted small fw-semibold mb-2">
                                                        <i class="bi bi-geo-alt me-1 text-warning"></i> @scene.Slugline
                                                    </div>

                                                    @if (scene.SceneCharacters != null && scene.SceneCharacters.Any())
                                                    {
                                                        <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-1 align-items-center">
                                                            <span class="text-muted small me-1">Герои:</span>
                                                            @foreach (var sc in scene.SceneCharacters)
                                                            {
                                                                <span class="badge bg-light text-dark border small rounded-pill px-2 py-1">@sc.Character?.Name</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                <div class="card-footer-actions d-flex justify-content-between align-items-center mt-3 pt-2 border-top flex-wrap gap-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button class="btn btn-action-subtle btn-sm rounded-pill px-3 py-1 d-inline-flex align-items-center"
                                                                title="Вставить новую сцену сразу после этой"
                                                                @onclick="() => InsertSceneAfter(scene.SceneNumber)"
                                                                @onclick:stopPropagation="true"
                                                                draggable="false">
                                                            <i class="bi bi-plus-circle me-1 text-warning"></i>
                                                            <span>Следующая</span>
                                                        </button>
                                                        <button class="btn btn-action-subtle btn-sm rounded-pill px-3 py-1 d-inline-flex align-items-center"
                                                                title="Клонировать сцену (создать дубликат)"
                                                                @onclick="() => DuplicateScene(scene.Id)"
                                                                @onclick:stopPropagation="true"
                                                                draggable="false">
                                                            <i class="bi bi-copy me-1 text-primary"></i>
                                                            <span>Клонировать</span>
                                                        </button>
                                                    </div>

                                                    <button class="btn btn-action-delete btn-sm rounded-pill px-3 py-1 d-inline-flex align-items-center shadow-none"
                                                            @onclick="async () => await DeleteScene(scene.Id)"
                                                            @onclick:stopPropagation="true"
                                                            draggable="false"
                                                            title="Удалить сцену">
                                                        <i class="bi bi-trash3 me-1"></i>
                                                        <span>Удалить</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="act-collapsed-preview px-4 py-2 bg-light border-top d-flex justify-content-between align-items-center small text-muted cursor-pointer"
                             @onclick="() => ToggleAct(act)">
                            <span>
                                <i class="bi bi-archive me-1"></i>Акт свернут (архивирован в рабочей области). Сцен: @totalInAct, завершено: @readyInAct.
                            </span>
                            <span class="text-warning fw-semibold extra-small">Нажмите, чтобы развернуть <i class="bi bi-chevron-down ms-1"></i></span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var scene in FilteredScenes)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 scene-card p-3 d-flex flex-column justify-content-between position-relative overflow-hidden @(draggedScene == scene ? "dragging" : "") @(dropTargetScene == scene && draggedScene != scene ? "drop-target" : "")"
                         draggable="true"
                         @onclick="() => OpenEditPage(scene)"
                         @ondragstart="(e) => OnDragStart(e, scene)"
                         @ondragend="OnDragEnd"
                         @ondragenter="() => OnDragEnter(scene)"
                         @ondragleave="() => OnDragLeave(scene)"
                         @ondragover="OnDragOver"
                         @ondragover:preventDefault="true"
                         @ondrop="() => OnDrop(scene)"
                         @ondrop:stopPropagation="true">
                        <div class="card-accent-bar" style="@GetAccentBarStyle(scene)"></div>

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="drag-handle" title="Зажмите для перетаскивания">
                                        <i class="bi bi-grip-vertical fs-5"></i>
                                    </span>
                                    <span class="badge scene-num-badge rounded-pill px-3 py-1 fw-bold">
                                        СЦЕНА @scene.SceneNumber
                                    </span>

                                    <select class="act-select-badge shadow-none"
                                            title="Переместить сцену в другой акт"
                                            draggable="false"
                                            @onclick:stopPropagation="true"
                                            value="@scene.Act.ToString()"
                                            @onchange="(e) => OnActSelectChanged(scene, e.Value)">
                                        <option value="Act1">Акт I</option>
                                        <option value="Act2">Акт II</option>
                                        <option value="Act3">Акт III</option>
                                    </select>

                                    <button type="button" class="btn badge @scene.Status.ToBadgeClass() rounded-pill px-2 py-1 shadow-none"
                                            title="Нажмите для смены статуса (Черновик → В работе → Готова)"
                                            @onclick="() => CycleSceneStatus(scene)"
                                            @onclick:stopPropagation="true"
                                            draggable="false">
                                        <i class="bi @scene.Status.ToIconClass() me-1"></i>@scene.Status.ToDisplayName()
                                    </button>
                                </div>
                            </div>

                            @if (scene.DramaticStructure != DramaticStructure.None)
                            {
                                <div class="mb-2">
                                    <span class="badge @scene.DramaticStructure.ToBadgeClass() rounded-pill px-2 py-1 small fw-semibold">
                                        <i class="bi @scene.DramaticStructure.ToIconClass() me-1"></i>@scene.DramaticStructure.ToDisplayName()
                                    </span>
                                </div>
                            }

                            <div class="mb-2">
                                @if (editingTitleSceneId == scene.Id)
                                {
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" @bind="tempTitle" @onkeyup="HandleTitleKeyUp" />
                                        <button class="btn btn-warning text-dark" @onclick="() => SaveInlineTitle(scene)"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-light" @onclick="CancelInlineTitle"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h5 class="fw-bold text-dark m-0 fs-6 text-truncate" title="@scene.DisplayTitle">
                                            @scene.DisplayTitle
                                        </h5>
                                        <button class="btn btn-sm btn-link text-muted p-0 ms-1 text-decoration-none edit-title-btn"
                                                title="Быстро изменить название"
                                                @onclick="() => StartInlineTitle(scene)"
                                                @onclick:stopPropagation="true"
                                                draggable="false">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                }
                            </div>

                            <div class="text-muted small fw-semibold mb-2">
                                <i class="bi bi-geo-alt me-1 text-warning"></i> @scene.Slugline
                            </div>

                            @if (scene.SceneCharacters != null && scene.SceneCharacters.Any())
                            {
                                <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-1 align-items-center">
                                    <span class="text-muted small me-1">Герои:</span>
                                    @foreach (var sc in scene.SceneCharacters)
                                    {
                                        <span class="badge bg-light text-dark border small rounded-pill px-2 py-1">@sc.Character?.Name</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="card-footer-actions d-flex justify-content-between align-items-center mt-3 pt-2 border-top flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-action-subtle btn-sm rounded-pill px-3 py-1 d-inline-flex align-items-center"
                                        title="Вставить новую сцену сразу после этой"
                                        @onclick="() => InsertSceneAfter(scene.SceneNumber)"
                                        @onclick:stopPropagation="true"
                                        draggable="false">
                                    <i class="bi bi-plus-circle me-1 text-warning"></i>
                                    <span>Следующая</span>
                                </button>
                                <button class="btn btn-action-subtle btn-sm rounded-pill px-3 py-1 d-inline-flex align-items-center"
                                        title="Клонировать сцену (создать дубликат)"
                                        @onclick="() => DuplicateScene(scene.Id)"
                                        @onclick:stopPropagation="true"
                                        draggable="false">
                                    <i class="bi bi-copy me-1 text-primary"></i>
                                    <span>Клонировать</span>
                                </button>
                            </div>

                            <button class="btn btn-action-delete btn-sm rounded-pill px-3 py-1 d-inline-flex align-items-center shadow-none"
                                    @onclick="async () => await DeleteScene(scene.Id)"
                                    @onclick:stopPropagation="true"
                                    draggable="false"
                                    title="Удалить сцену">
                                <i class="bi bi-trash3 me-1"></i>
                                <span>Удалить</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int ProjectId { get; set; }

    private List<Scene> scenes = new();
    private bool isLoading = true;

    private bool isActView = true;
    private HashSet<MovieAct> collapsedActs = new();
    private bool allActsCollapsed => collapsedActs.Count == Enum.GetValues(typeof(MovieAct)).Length;

    private string currentFilter = "all";
    private Scene? draggedScene;
    private Scene? dropTargetScene;

    private int? editingTitleSceneId;
    private string tempTitle = string.Empty;

    private int DraftCount => scenes.Count(s => s.Status == SceneStatus.Draft);
    private int InProgressCount => scenes.Count(s => s.Status == SceneStatus.InProgress);
    private int ReadyCount => scenes.Count(s => s.Status == SceneStatus.Ready);
    private int DramaticCount => scenes.Count(s => s.DramaticStructure != DramaticStructure.None);
    private int ReadinessPercent => scenes.Any() ? (int)Math.Round((double)ReadyCount / scenes.Count * 100) : 0;

    private IEnumerable<Scene> FilteredScenes => currentFilter switch
    {
        "draft" => scenes.Where(s => s.Status == SceneStatus.Draft),
        "inprogress" => scenes.Where(s => s.Status == SceneStatus.InProgress),
        "ready" => scenes.Where(s => s.Status == SceneStatus.Ready),
        "dramatic" => scenes.Where(s => s.DramaticStructure != DramaticStructure.None),
        _ => scenes
    };

    private IEnumerable<Scene> GetFilteredScenesForAct(MovieAct act)
    {
        return FilteredScenes.Where(s => s.Act == act);
    }

    private IEnumerable<DramaticStructure> GetActMarkers(MovieAct act)
    {
        return scenes
            .Where(s => s.Act == act && s.DramaticStructure != DramaticStructure.None)
            .Select(s => s.DramaticStructure)
            .Distinct();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadScenes();
    }

    private async Task LoadScenes()
    {
        isLoading = true;
        scenes = await SceneService.GetScenesByProjectIdAsync(ProjectId);
        isLoading = false;
    }

    private void SetFilter(string filter)
    {
        currentFilter = filter;
    }

    private void ToggleAct(MovieAct act)
    {
        if (collapsedActs.Contains(act))
        {
            collapsedActs.Remove(act);
        }
        else
        {
            collapsedActs.Add(act);
        }
    }

    private void ToggleAllActs()
    {
        if (allActsCollapsed)
        {
            collapsedActs.Clear();
        }
        else
        {
            foreach (MovieAct a in Enum.GetValues(typeof(MovieAct)))
            {
                collapsedActs.Add(a);
            }
        }
    }

    private void OpenCreatePage(MovieAct? act = null)
    {
        if (act.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/scenes/new?act={act.Value}");
        }
        else
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/scenes/new");
        }
    }

    private void InsertSceneAfter(int sceneNumber)
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/scenes/new?after={sceneNumber}");
    }

    private void OpenEditPage(Scene scene)
    {
        if (draggedScene != null) return;
        Navigation.NavigateTo($"/projects/{ProjectId}/scenes/{scene.Id}/edit");
    }

    private void OnDragStart(DragEventArgs e, Scene scene)
    {
        draggedScene = scene;
        dropTargetScene = null;
        if (e.DataTransfer != null)
        {
            e.DataTransfer.EffectAllowed = "move";
            e.DataTransfer.DropEffect = "move";
        }
    }

    private void OnDragEnter(Scene target)
    {
        if (draggedScene != null && draggedScene.Id != target.Id)
        {
            dropTargetScene = target;
        }
    }

    private void OnDragLeave(Scene target)
    {
        if (dropTargetScene?.Id == target.Id)
        {
            dropTargetScene = null;
        }
    }

    private void OnDragOver(DragEventArgs e)
    {
        if (e.DataTransfer != null)
        {
            e.DataTransfer.DropEffect = "move";
        }
    }

    private async Task OnDrop(Scene targetScene)
    {
        var item = draggedScene;
        draggedScene = null;
        dropTargetScene = null;

        if (item == null || item.Id == targetScene.Id)
        {
            StateHasChanged();
            return;
        }

        if (item.Act != targetScene.Act)
        {
            await SceneService.MoveSceneToActAsync(item.Id, targetScene.Act, targetScene.Id);
            scenes = await SceneService.GetScenesByProjectIdAsync(ProjectId);
        }
        else
        {
            int originalIndex = scenes.FindIndex(s => s.Id == item.Id);
            int targetIndex = scenes.FindIndex(s => s.Id == targetScene.Id);

            if (originalIndex != -1 && targetIndex != -1)
            {
                scenes.RemoveAt(originalIndex);
                scenes.Insert(targetIndex, item);

                for (int i = 0; i < scenes.Count; i++)
                {
                    scenes[i].SceneNumber = i + 1;
                }

                var orderedIds = scenes.Select(s => s.Id).ToList();
                await SceneService.UpdateScenesOrderAsync(orderedIds, ProjectId);
            }
        }

        StateHasChanged();
    }

    private async Task OnDropOnAct(MovieAct targetAct)
    {
        var item = draggedScene;
        draggedScene = null;
        dropTargetScene = null;

        if (item == null || item.Act == targetAct)
        {
            StateHasChanged();
            return;
        }

        await SceneService.MoveSceneToActAsync(item.Id, targetAct);
        scenes = await SceneService.GetScenesByProjectIdAsync(ProjectId);
        StateHasChanged();
    }

    private void OnDragEnd()
    {
        draggedScene = null;
        dropTargetScene = null;
        StateHasChanged();
    }

    private async Task OnActSelectChanged(Scene scene, object? value)
    {
        if (value != null && Enum.TryParse<MovieAct>(value.ToString(), out var newAct))
        {
            if (scene.Act == newAct) return;

            await SceneService.MoveSceneToActAsync(scene.Id, newAct);
            scenes = await SceneService.GetScenesByProjectIdAsync(ProjectId);
            StateHasChanged();
        }
    }

    private async Task CycleSceneStatus(Scene scene)
    {
        var nextStatus = scene.Status switch
        {
            SceneStatus.Draft => SceneStatus.InProgress,
            SceneStatus.InProgress => SceneStatus.Ready,
            SceneStatus.Ready => SceneStatus.Draft,
            _ => SceneStatus.Draft
        };

        scene.Status = nextStatus;
        await SceneService.UpdateSceneStatusAsync(scene.Id, nextStatus);
        StateHasChanged();
    }

    private string GetAccentBarStyle(Scene scene)
    {
        if (scene.DramaticStructure == DramaticStructure.Climax)
            return "background: linear-gradient(180deg, #EF4444 0%, #DC2626 100%); width: 5px;";
        if (scene.DramaticStructure == DramaticStructure.Midpoint)
            return "background: linear-gradient(180deg, #F59E0B 0%, #D97706 100%); width: 5px;";
        if (scene.DramaticStructure == DramaticStructure.Exposition)
            return "background: linear-gradient(180deg, #8B5CF6 0%, #7C3AED 100%); width: 5px;";
        if (scene.DramaticStructure == DramaticStructure.Resolution)
            return "background: linear-gradient(180deg, #06B6D4 0%, #0891B2 100%); width: 5px;";

        return scene.Status switch
        {
            SceneStatus.Ready => "background: #10B981;",
            SceneStatus.InProgress => "background: #3B82F6;",
            _ => "background: #94A3B8;"
        };
    }

    private async Task DuplicateScene(int sceneId)
    {
        var dup = await SceneService.DuplicateSceneAsync(sceneId);
        if (dup != null)
        {
            await LoadScenes();
        }
    }

    private void StartInlineTitle(Scene scene)
    {
        editingTitleSceneId = scene.Id;
        tempTitle = scene.Title;
    }

    private void CancelInlineTitle()
    {
        editingTitleSceneId = null;
        tempTitle = string.Empty;
    }

    private async Task SaveInlineTitle(Scene scene)
    {
        scene.Title = tempTitle.Trim();
        await SceneService.UpdateSceneAsync(scene);
        editingTitleSceneId = null;
    }

    private async Task HandleTitleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var target = scenes.FirstOrDefault(s => s.Id == editingTitleSceneId);
            if (target != null)
            {
                await SaveInlineTitle(target);
            }
        }
        else if (e.Key == "Escape")
        {
            CancelInlineTitle();
        }
    }

    private async Task DeleteScene(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Удалить эту сцену? Нумерация остальных сцен автоматически пересчитается.");
        if (!confirmed) return;

        await SceneService.DeleteSceneAsync(id);
        await LoadScenes();
    }

    private string GetScenesWord(int count)
    {
        int rem10 = count % 10;
        int rem100 = count % 100;
        if (rem100 >= 11 && rem100 <= 19) return "сцен";
        if (rem10 == 1) return "сцена";
        if (rem10 >= 2 && rem10 <= 4) return "сцены";
        return "сцен";
    }
}