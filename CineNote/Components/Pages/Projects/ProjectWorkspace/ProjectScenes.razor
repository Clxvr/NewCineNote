@page "/projects/{ProjectId:int}/scenes"
@layout ProjectLayout
@using CineNote.Models
@using CineNote.Services
@inject SceneService SceneService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="/images/icons/icon_timeline.png" alt="" width="42" height="42" style="object-fit: contain;" />
        <div>
            <h3 class="fw-bold text-dark mb-0">Сцены проекта</h3>
            <p class="text-muted small mb-0">Поэпизодный план и структура сценария</p>
        </div>
    </div>
    <button class="btn btn-warning rounded-3 px-3 py-2 fw-semibold text-dark shadow-sm" @onclick="OpenCreatePage">
        <i class="bi bi-plus-lg me-1"></i> Добавить сцену
    </button>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (!scenes.Any())
{
    <div class="text-center py-5 border rounded-4 bg-light p-5">
        <div class="mb-3">
            <img src="/images/icons/icon_timeline.png" alt="" width="95" height="95" style="object-fit: contain; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.08)); opacity: 0.8;" />
        </div>
        <h5 class="fw-bold text-dark mb-1">Сцены пока не добавлены</h5>
        <p class="text-muted small mb-3">Начните создавать поэпизодный план: добавляйте локации, время и описывайте действие.</p>
        <button class="btn btn-warning rounded-3 px-4 py-2 fw-semibold text-dark shadow-sm" @onclick="OpenCreatePage">
            <i class="bi bi-plus-lg me-1"></i> Добавить первую сцену
        </button>
    </div>
}
else
{
    <!-- Сетка карточек в стиле персонажей -->
    <div class="row g-3">
        @foreach (var scene in scenes)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-3 position-relative overflow-hidden">
                    <!-- Синяя полоска слева -->
                    <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #2563EB;"></div>

                    <div class="card-body d-flex flex-column justify-content-between p-0 ps-2">
                        <div class="flex-grow-1 mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold text-dark m-0 fs-6 text-uppercase">
                                    <span class="text-muted me-1">@scene.SceneNumber.</span>@scene.Slugline
                                </h5>
                            </div>

                            <span class="fw-semibold text-dark small d-block mb-1 mt-3">Описание действия:</span>

                            <div class="text-muted small lh-base mb-0 overflow-hidden" style="max-height: 90px; position: relative;">
                                @if (string.IsNullOrEmpty(scene.ActionDescription))
                                {
                                    <span>описание отсутствует.</span>
                                }
                                else
                                {
                                    @((MarkupString)scene.ActionDescription)
                                }
                                <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 30px; background: linear-gradient(transparent, white);"></div>
                            </div>

                            <!-- Список персонажей в сцене -->
                            @if (scene.SceneCharacters != null && scene.SceneCharacters.Any())
                            {
                                <div class="mt-3 pt-2 border-top d-flex flex-wrap gap-1 align-items-center">
                                    <span class="text-muted small me-1">Герои:</span>
                                    @foreach (var sc in scene.SceneCharacters)
                                    {
                                        <span class="badge bg-light text-dark border small rounded-pill px-2 py-1">@sc.Character?.Name</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                            <button class="btn btn-sm btn-outline-secondary rounded-2" @onclick="() => OpenEditPage(scene)">
                                Редактировать
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-2" @onclick="() => DeleteScene(scene.Id)">
                                Удалить
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int ProjectId { get; set; }

    private List<Scene> scenes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadScenes();
    }

    private async Task LoadScenes()
    {
        isLoading = true;
        scenes = await SceneService.GetScenesByProjectIdAsync(ProjectId);
        isLoading = false;
    }

    private void OpenCreatePage()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/scenes/new");
    }

    private void OpenEditPage(Scene scene)
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/scenes/{scene.Id}/edit");
    }

    private async Task DeleteScene(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Удалить эту сцену? Это действие нельзя отменить.");
        if (!confirmed) return;

        await SceneService.DeleteSceneAsync(id);
        await LoadScenes();
    }
}