@page "/projects/{ProjectId:int}/share"
@layout ProjectLayout
@rendermode InteractiveServer
@using CineNote.Models
@using CineNote.Services
@inject ProjectShareService ShareService
@inject MovieProjectService ProjectService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="share-page-container">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="share-header-icon rounded-4 d-flex align-items-center justify-content-center shadow-sm">
                <i class="bi bi-people-fill fs-3 text-warning"></i>
            </div>
            <div>
                <h3 class="fw-bold text-dark mb-0">Совместный доступ</h3>
                <p class="text-muted small mb-0">Приглашение соавторов, разграничение прав и командная работа над фильмом</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(currentUserRole))
        {
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Ваша роль:</span>
                <span class="badge @ProjectAccessLevel.ToBadgeClass(currentUserRole) rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi @ProjectAccessLevel.ToIconClass(currentUserRole) me-1"></i>
                    @currentUserRole
                </span>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (project == null)
    {
        <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center">
            <h5>Проект не найден или у вас нет прав на его просмотр.</h5>
            <a href="/projects" class="btn btn-dark mt-2">К списку проектов</a>
        </div>
    }
    else
    {

        @if (isOwner)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 invite-card">
                <h5 class="fw-bold text-dark mb-2">
                    <i class="bi bi-person-plus me-2 text-warning"></i>Пригласить соавтора
                </h5>
                <p class="text-muted small mb-3">
                    Введите Email зарегистрированного пользователя CineNote и укажите уровень доступа.
                </p>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert @(isSuccessMessage ? "alert-success" : "alert-danger") alert-dismissible fade show rounded-3 p-3 mb-3 d-flex align-items-center justify-content-between" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @(isSuccessMessage ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
                            <span>@statusMessage</span>
                        </div>
                        <button type="button" class="btn-close shadow-none p-2" @onclick="() => statusMessage = null"></button>
                    </div>
                }

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-secondary mb-1">Email пользователя</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control border-start-0 shadow-none"
                                   placeholder="colleague@cinenote.com"
                                   @bind="inviteEmail"
                                   @bind:event="oninput"
                                   @onkeyup="HandleKeyUp" />
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">Права доступа</label>
                        <select class="form-select shadow-none" @bind="inviteAccessLevel">
                            <option value="@ProjectAccessLevel.Editor">Редактор (полные правки)</option>
                            <option value="@ProjectAccessLevel.Viewer">Читатель (только чтение)</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <button class="btn btn-warning w-100 fw-semibold text-dark shadow-sm py-2 d-flex align-items-center justify-content-center gap-2"
                                @onclick="InviteCollaborator"
                                disabled="@(isSubmitting || string.IsNullOrWhiteSpace(inviteEmail))">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Добавление...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                                <span>Пригласить</span>
                            }
                        </button>
                    </div>
                </div>

                <div class="mt-3 p-3 rounded-3 bg-light border small text-muted d-flex align-items-center gap-3 flex-wrap">
                    <div>
                        <span class="badge bg-primary me-1"><i class="bi bi-pencil-fill me-1"></i>Редактор</span>
                        <span>Может редактировать синопсис, логлайн, добавлять и изменять сцены и героев.</span>
                    </div>
                    <div>
                        <span class="badge bg-secondary me-1"><i class="bi bi-eye-fill me-1"></i>Читатель</span>
                        <span>Может только просматривать сценарий без возможности вносить изменения.</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-light mb-4">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-info-circle-fill text-primary fs-4"></i>
                    <div class="small text-muted">
                        Вы участвуете в проекте в качестве соавтора с правами <strong>«@currentUserRole»</strong>. Управлять списком соавторов и приглашать новых участников может только создатель (владелец) проекта.
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark m-0">
                    <i class="bi bi-people me-2 text-warning"></i>Участники проекта (@(1 + shares.Count))
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th scope="col" class="border-0">Участник</th>
                            <th scope="col" class="border-0">Email</th>
                            <th scope="col" class="border-0">Роль в проекте</th>
                            <th scope="col" class="border-0 text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr class="owner-row">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar-circle owner-avatar shadow-sm">
                                        <i class="bi bi-star-fill text-warning"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@(project.User?.Name ?? "Владелец")</div>
                                        <div class="extra-small text-muted">Создатель проекта</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-muted small">@(project.User?.Email ?? "—")</td>
                            <td>
                                <span class="badge badge-access-owner rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-star-fill me-1"></i>Владелец
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="text-muted small fst-italic">Главный автор</span>
                            </td>
                        </tr>

                        @if (!shares.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">
                                    <i class="bi bi-person-dash text-secondary fs-3 d-block mb-1"></i>
                                    <span>В этом проекте пока нет соавторов.</span>
                                    @if (isOwner)
                                    {
                                        <span> Пригласите коллег с помощью формы выше.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var share in shares)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-avatar-circle collaborator-avatar">
                                                @(GetUserInitials(share.SharedWithUser?.Name))
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@(share.SharedWithUser?.Name ?? "Пользователь")</div>
                                                <div class="extra-small text-muted">Соавтор</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@(share.SharedWithUser?.Email ?? "—")</td>
                                    <td>
                                        @if (isOwner)
                                        {

                                            <select class="form-select form-select-sm role-select shadow-none d-inline-block w-auto"
                                                    value="@share.AccessLevel"
                                                    @onchange="(e) => ChangeShareRole(share, e.Value)">
                                                <option value="@ProjectAccessLevel.Editor">Редактор</option>
                                                <option value="@ProjectAccessLevel.Viewer">Читатель</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="badge @ProjectAccessLevel.ToBadgeClass(share.AccessLevel) rounded-pill px-3 py-1 fw-semibold">
                                                <i class="bi @ProjectAccessLevel.ToIconClass(share.AccessLevel) me-1"></i>
                                                @share.AccessLevel
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (isOwner)
                                        {
                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 shadow-none"
                                                    @onclick="() => RevokeAccess(share)"
                                                    title="Отозвать доступ">
                                                <i class="bi bi-person-x me-1"></i>Отозвать
                                            </button>
                                        }
                                        else if (share.SharedWithUserId == currentUserId)
                                        {
                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 shadow-none"
                                                    @onclick="() => LeaveProject()"
                                                    title="Покинуть проект">
                                                <i class="bi bi-box-arrow-right me-1"></i>Покинуть
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private MovieProject? project;
    private List<ProjectShare> shares = new();
    private bool isLoading = true;

    private int currentUserId;
    private string? currentUserRole;
    private bool isOwner => currentUserRole == ProjectAccessLevel.Owner;

    private string inviteEmail = string.Empty;
    private string inviteAccessLevel = ProjectAccessLevel.Editor;
    private bool isSubmitting = false;

    private string? statusMessage;
    private bool isSuccessMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        currentUserId = AuthService.CurrentUser?.Id ?? 0;

        if (currentUserId > 0)
        {
            project = await ProjectService.GetProjectByIdAndUserAsync(ProjectId, currentUserId);
            currentUserRole = await ShareService.GetUserAccessLevelAsync(ProjectId, currentUserId);

            if (project != null && currentUserRole != null)
            {
                shares = await ShareService.GetProjectSharesAsync(ProjectId);
            }
        }

        isLoading = false;
    }

    private async Task InviteCollaborator()
    {
        if (string.IsNullOrWhiteSpace(inviteEmail)) return;

        isSubmitting = true;
        statusMessage = null;

        var result = await ShareService.InviteCollaboratorByEmailAsync(
            ProjectId,
            currentUserId,
            inviteEmail,
            inviteAccessLevel
        );

        isSuccessMessage = result.Success;
        statusMessage = result.Message;

        if (result.Success)
        {
            inviteEmail = string.Empty;
            shares = await ShareService.GetProjectSharesAsync(ProjectId);
        }

        isSubmitting = false;
    }

    private async Task ChangeShareRole(ProjectShare share, object? newRoleValue)
    {
        if (newRoleValue == null) return;
        string newRole = newRoleValue.ToString() ?? ProjectAccessLevel.Viewer;

        var result = await ShareService.UpdateShareAccessLevelAsync(share.Id, currentUserId, newRole);

        isSuccessMessage = result.Success;
        statusMessage = result.Message;

        if (result.Success)
        {
            share.AccessLevel = newRole;
        }
    }

    private async Task RevokeAccess(ProjectShare share)
    {
        string name = share.SharedWithUser?.Name ?? "соавтора";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Отозвать доступ к проекту для «{name}»?");
        if (!confirmed) return;

        var result = await ShareService.RemoveShareAsync(share.Id, currentUserId);

        isSuccessMessage = result.Success;
        statusMessage = result.Message;

        if (result.Success)
        {
            shares.Remove(share);
        }
    }

    private async Task LeaveProject()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Вы действительно хотите покинуть этот совместный проект?");
        if (!confirmed) return;

        var result = await ShareService.LeaveProjectAsync(ProjectId, currentUserId);
        if (result.Success)
        {
            Navigation.NavigateTo("/projects");
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await InviteCollaborator();
        }
    }

    private string GetUserInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }
}
