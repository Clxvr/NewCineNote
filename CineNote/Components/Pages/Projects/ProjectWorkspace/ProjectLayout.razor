@inherits LayoutComponentBase
@using CineNote.Models
@using CineNote.Services
@inject MovieProjectService ProjectService
@inject NavigationManager Navigation

<div class="container-fluid workspace-container px-4 py-3">
    @if (project == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-dark" role="status"></div>
            <p class="text-muted mt-2">Загрузка контекста проекта...</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom px-2">
            <div>
                <a href="/projects" class="text-decoration-none text-muted small fw-semibold">⬅ Назад к списку проектов</a>
                <h2 class="fw-bold m-0 mt-1 text-dark">@project.Title</h2>
                <span class="badge px-3 py-2 rounded-pill small fw-semibold mt-2 genre-badge">
                    <i class="bi bi-tag-fill me-1"></i> @GetGenreDisplayName(project.Genre)
                </span>
            </div>
        </div>

        <div class="row g-4">
            <!-- Узкая боковая панель (col-lg-2) -->
            <div class="col-12 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 p-3 sidebar-card">
                    <span class="text-muted small fw-bold d-block mb-3 px-2 text-uppercase nav-title">Навигация</span>
                    <div class="d-flex flex-column gap-2">
                        <NavLink class="btn nav-menu-btn text-start py-2 px-3 rounded-3 fw-semibold small text-dark text-decoration-none bg-hover-light d-flex align-items-center" href="@($"/projects/{ProjectId}")" Match="NavLinkMatch.All" ActiveClass="btn-dark text-white shadow-sm">
                            <i class="bi bi-file-earmark-text me-2"></i> Логлайн
                        </NavLink>

                        <NavLink class="btn nav-menu-btn text-start py-2 px-3 rounded-3 fw-semibold small text-dark text-decoration-none bg-hover-light d-flex align-items-center" href="@($"/projects/{ProjectId}/scenes")" ActiveClass="btn-dark text-white shadow-sm">
                            <i class="bi bi-film me-2"></i> Сцены
                        </NavLink>

                        <NavLink class="btn nav-menu-btn text-start py-2 px-3 rounded-3 fw-semibold small text-dark text-decoration-none bg-hover-light d-flex align-items-center" href="@($"/projects/{ProjectId}/characters")" ActiveClass="btn-dark text-white shadow-sm">
                            <i class="bi bi-people me-2"></i> Персонажи
                        </NavLink>

                        <NavLink class="btn nav-menu-btn text-start py-2 px-3 rounded-3 fw-semibold small text-dark text-decoration-none bg-hover-light d-flex align-items-center" href="@($"/projects/{ProjectId}/share")" ActiveClass="btn-dark text-white shadow-sm">
                            <i class="bi bi-share me-2"></i> Доступ
                        </NavLink>
                    </div>
                </div>
            </div>

            <!-- Расширенная зона контента (col-lg-10) -->
            <div class="col-12 col-lg-10">
                <div class="card border-0 shadow-sm rounded-4 p-4 content-card min-vh-75">
                    @Body
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int ProjectId;
    private MovieProject? project;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var segments = uri.Segments;

        for (int i = 0; i < segments.Length; i++)
        {
            if (segments[i].Trim('/') == "projects" && i + 1 < segments.Length)
            {
                if (int.TryParse(segments[i + 1].Trim('/'), out int id))
                {
                    ProjectId = id;
                    project = await ProjectService.GetProjectByIdAndUserAsync(ProjectId, 1);
                    break;
                }
            }
        }
    }

    private string GetGenreDisplayName(Genre genre)
    {
        return genre switch
        {
            Genre.Drama => "Драма",
            Genre.Comedy => "Комедия",
            Genre.Action => "Боевик",
            Genre.Thriller => "Триллер",
            Genre.SciFi => "Фантастика",
            Genre.Horror => "Ужасы",
            Genre.Romance => "Мелодрама",
            Genre.Fantasy => "Фэнтези",
            Genre.Mystery => "Детектив",
            Genre.Crime => "Криминал",
            Genre.Animation => "Анимация",
            Genre.Documentary => "Документальный",
            Genre.Other => "Другое",
            _ => genre.ToString()
        };
    }
}