@using CineNote.Components.Layout
@layout MainLayout
@inherits LayoutComponentBase
@using CineNote.Models
@using CineNote.Services
@inject MovieProjectService ProjectService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container-fluid workspace-container px-4 py-3">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border workspace-spinner"></div>
        </div>
    }
    else if (project == null)
    {
        <div class="text-center py-5">
            <p class="text-muted">Проект не найден.</p>
            <a href="/projects">Вернуться к проектам</a>
        </div>
    }
    else
    {
        <div class="workspace-header d-flex justify-content-between align-items-start mb-4 pb-3 px-2">
            <div>
                <h2 class="workspace-project-title fw-bold m-0">@project.Title</h2>

                <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                    @if (!isEditingGenre)
                    {
                        <span class="workspace-genre">
                            <i class="bi bi-tag-fill me-1"></i>
                            @GetGenreDisplayName(project.Genre)
                        </span>

                        <button class="workspace-edit-genre" @onclick="StartEditingGenre">
                            <i class="bi bi-pencil"></i>
                            Изменить жанр
                        </button>
                    }
                    else
                    {
                        <select class="form-select form-select-sm workspace-genre-select" @bind="selectedGenre">
                            @foreach (Genre genre in Enum.GetValues(typeof(Genre)))
                            {
                                <option value="@genre">@GetGenreDisplayName(genre)</option>
                            }
                        </select>

                        <button class="btn workspace-button btn-sm" @onclick="SaveGenre" disabled="@isSavingGenre">Сохранить</button>
                        <button class="btn workspace-cancel-button btn-sm" @onclick="CancelEditingGenre">Отмена</button>
                    }
                </div>
            </div>

        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-2">
                <div class="workspace-sidebar">
                    <span class="workspace-sidebar-title d-block mb-3 px-2 text-uppercase">
                        Рабочее пространство
                    </span>

                    <div class="d-flex flex-column gap-2">
                        <NavLink class="workspace-nav-link" href="@($"/projects/{ProjectId}")" Match="NavLinkMatch.All">
                            <i class="bi bi-file-earmark-text"></i>
                            Обзор проекта
                        </NavLink>

                        <NavLink class="workspace-nav-link" href="@($"/projects/{ProjectId}/scenes")">
                            <i class="bi bi-film"></i>
                            Сцены
                        </NavLink>

                        <NavLink class="workspace-nav-link" href="@($"/projects/{ProjectId}/characters")">
                            <i class="bi bi-people"></i>
                            Персонажи
                        </NavLink>

                        <NavLink class="workspace-nav-link" href="@($"/projects/{ProjectId}/share")">
                            <i class="bi bi-share"></i>
                            Доступ к проекту
                        </NavLink>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-10">
                <div class="workspace-content p-4">
                    @Body
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private MovieProject? project;
    private bool isLoading = true;
    private bool isEditingGenre;
    private bool isSavingGenre;
    private Genre selectedGenre;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var segments = uri.AbsolutePath.Trim('/').Split('/');
        for (int i = 0; i < segments.Length - 1; i++)
        {
            if (segments[i] == "projects" && int.TryParse(segments[i + 1], out int id))
            {
                ProjectId = id;
                break;
            }
        }

        project = await ProjectService.GetProjectByIdAndUserAsync(ProjectId, AuthService.CurrentUser?.Id ?? 0);

        if (project != null)
        {
            selectedGenre = project.Genre;
        }

        isLoading = false;
    }

    private void StartEditingGenre()
    {
        selectedGenre = project!.Genre;
        isEditingGenre = true;
    }

    private async Task SaveGenre()
    {
        if (project == null) return;

        isSavingGenre = true;

        try
        {
            bool result = await ProjectService.UpdateGenreAsync(ProjectId, AuthService.CurrentUser?.Id ?? 0, selectedGenre);

            if (result)
            {
                project.Genre = selectedGenre;
                isEditingGenre = false;
            }
        }
        finally
        {
            isSavingGenre = false;
        }
    }

    private void CancelEditingGenre()
    {
        selectedGenre = project!.Genre;
        isEditingGenre = false;
    }

    private string GetGenreDisplayName(Genre genre)
    {
        return genre switch
        {
            Genre.Drama => "Драма",
            Genre.Comedy => "Комедия",
            Genre.Thriller => "Триллер",
            Genre.Horror => "Ужасы",
            Genre.Fantasy => "Фэнтези",
            Genre.Action => "Боевик",
            Genre.Romance => "Мелодрама",
            Genre.SciFi => "Фантастика",
            _ => genre.ToString()
        };
    }
}
