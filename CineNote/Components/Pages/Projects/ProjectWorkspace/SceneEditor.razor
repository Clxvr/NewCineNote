@page "/projects/{ProjectId:int}/scenes/new"
@page "/projects/{ProjectId:int}/scenes/{SceneId:int}/edit"
@layout ProjectLayout
@using CineNote.Models
@using CineNote.Services
@inject SceneService SceneService
@inject CharacterService CharacterService
@inject ProjectShareService ShareService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="d-flex flex-column h-100">
    <div class="section-header mb-4">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <h3 class="fw-bold text-dark mb-0">@(SceneId.HasValue ? $"Сцена {scene.SceneNumber}: {scene.DisplayTitle}" : (insertAfterNumber.HasValue ? $"Вставка сцены после №{insertAfterNumber}" : "Новая сцена"))</h3>
                <p class="text-muted small mb-0">Полноэкранный сценарный редактор</p>
            </div>
        </div>
        @if (canEdit)
        {
            <button class="btn btn-warning rounded-3 px-4 py-2 fw-semibold text-dark shadow-sm" @onclick="SaveScene" disabled="@isSaving">
                <i class="bi bi-check-lg me-1"></i> @(isSaving ? "Сохранение..." : "Сохранить и выйти")
            </button>
        }
        else
        {
            <span class="badge bg-secondary p-2 px-3 rounded-pill fs-6 fw-normal">
                <i class="bi bi-eye me-1"></i>Только чтение
            </span>
        }
    </div>

    @if (!canEdit && !isLoading)
    {
        <div class="cine-alert-readonly">
            <i class="bi bi-shield-lock-fill text-warning fs-3"></i>
            <div>
                <span class="fw-bold text-dark d-block">Режим совместного чтения</span>
                <span class="text-muted small">Вы просматриваете сцену с правами «Читатель». Изменение параметров, текста и привязки персонажей отключены владельцем проекта.</span>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                <div class="cine-card bg-light">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Название сцены (необязательно)</label>
                        <InputText @bind-Value="scene.Title" disabled="@(!canEdit)" class="form-control border-0 shadow-sm rounded-3" placeholder="Например: Знакомство в кафе или Побег через крышу" />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">ИНТ/НАТ</label>
                            <InputSelect @bind-Value="scene.LocationType" disabled="@(!canEdit)" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (LocationType loc in Enum.GetValues(typeof(LocationType)))
                                {
                                    <option value="@loc">@loc.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Объект (Локация)</label>
                            <InputText @bind-Value="scene.LocationName" disabled="@(!canEdit)" class="form-control border-0 shadow-sm rounded-3 text-uppercase" placeholder="КВАРТИРА ГЕРОЯ" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">Время суток</label>
                            <InputSelect @bind-Value="scene.TimeOfDay" disabled="@(!canEdit)" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (TimeOfDay time in Enum.GetValues(typeof(TimeOfDay)))
                                {
                                    <option value="@time">@time.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">
                                <i class="bi bi-folder2 me-1 text-warning"></i>Акт сценария
                            </label>
                            <InputSelect @bind-Value="scene.Act" disabled="@(!canEdit)" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (MovieAct act in Enum.GetValues(typeof(MovieAct)))
                                {
                                    <option value="@act">@act.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">
                                <i class="bi bi-hourglass-split me-1 text-warning"></i>Статус готовности
                            </label>
                            <InputSelect @bind-Value="scene.Status" disabled="@(!canEdit)" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (SceneStatus status in Enum.GetValues(typeof(SceneStatus)))
                                {
                                    <option value="@status">@status.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">
                                <i class="bi bi-diagram-3 me-1 text-warning"></i>Поворотная точка
                            </label>
                            <InputSelect @bind-Value="scene.DramaticStructure" disabled="@(!canEdit)" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (DramaticStructure marker in Enum.GetValues(typeof(DramaticStructure)))
                                {
                                    <option value="@marker">@marker.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="cine-card flex-grow-1 d-flex flex-column overflow-hidden p-0">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold text-dark m-0">Описание действия и диалоги</h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        @if (canEdit)
                        {
                            <QuillEditor @ref="actionEditor" InitialHtml="@scene.ActionDescription" MinHeight="400px" />
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded-3 flex-grow-1 overflow-auto" style="min-height: 400px; white-space: pre-wrap;">
                                @((MarkupString)(string.IsNullOrWhiteSpace(scene.ActionDescription) ? "<span class='text-muted'>Описание действия отсутствует</span>" : scene.ActionDescription))
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4 d-flex flex-column gap-4">
                <div class="cine-card">
                    <h5 class="fw-bold text-dark mb-3">Участники сцены</h5>
                    <p class="text-muted small mb-3">Выберите персонажей, которые присутствуют в этой сцене:</p>

                    @if (!allProjectCharacters.Any())
                    {
                        <div class="empty-state-box">
                            В проекте пока нет ни одного героя. Сначала добавьте их на вкладке «Персонажи».
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 280px;">
                            @foreach (var character in allProjectCharacters)
                            {
                                <div class="form-check select-check-card">
                                    <input class="form-check-input ms-0" type="checkbox"
                                           id="char-@character.Id"
                                           disabled="@(!canEdit)"
                                           checked="@selectedCharacterIds.Contains(character.Id)"
                                           @onchange="(e) => OnCharacterCheckboxChanged(character.Id, e.Value)" />
                                    <label class="form-check-label fw-semibold text-dark w-100 cursor-pointer" for="char-@character.Id">
                                        @character.Name <span class="text-muted small fw-normal ms-1">(@character.Role.ToDisplayName())</span>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="cine-card flex-grow-1">
                    <h5 class="fw-bold text-dark mb-2">
                        <i class="bi bi-box-seam me-2 text-warning"></i>Реквизит и транспорт
                    </h5>
                    <p class="text-muted small mb-3">Теги для вызывной сводки съемочной группы:</p>

                    @if (canEdit)
                    {
                        <div class="d-flex flex-column gap-2 mb-3 p-3 bg-light rounded-3 border">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   placeholder="Например: Револьвер, Черный седан..."
                                   @bind="newPropName"
                                   @bind:event="oninput"
                                   @onkeyup="HandlePropKeyUp" />
                            <div class="d-flex gap-2">
                                <select class="form-select form-select-sm" @bind="newPropCategory">
                                    @foreach (PropCategory cat in Enum.GetValues(typeof(PropCategory)))
                                    {
                                        <option value="@cat">@cat.ToDisplayName()</option>
                                    }
                                </select>
                                <input type="number"
                                       class="form-control form-control-sm"
                                       style="width: 75px;"
                                       min="1"
                                       max="999"
                                       title="Количество"
                                       @bind="newPropQuantity" />
                                <button type="button"
                                        class="btn btn-warning btn-sm px-3 fw-semibold text-dark text-nowrap"
                                        @onclick="AddProp"
                                        disabled="@string.IsNullOrWhiteSpace(newPropName)">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                    }

                    @if (!sceneProps.Any())
                    {
                        <div class="empty-state-box">
                            Реквизит и транспорт для этой сцены пока не указаны.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var prop in sceneProps)
                            {
                                <span class="badge @prop.Category.ToBadgeClass() rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 fw-medium">
                                    <i class="bi @prop.Category.ToIconClass()"></i>
                                    <span>@prop.Name@(prop.Quantity > 1 ? $" ×{prop.Quantity}" : "")</span>
                                    @if (canEdit)
                                    {
                                        <button type="button"
                                                class="btn-close shadow-none"
                                                style="font-size: 0.6rem;"
                                                title="Удалить тег"
                                                @onclick="() => RemoveProp(prop)"></button>
                                    }
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int? SceneId { get; set; }
    [SupplyParameterFromQuery(Name = "after")] public int? insertAfterNumber { get; set; }
    [SupplyParameterFromQuery(Name = "act")] public string? targetAct { get; set; }

    private Scene scene = new();
    private List<Character> allProjectCharacters = new();
    private HashSet<int> selectedCharacterIds = new();
    private List<SceneProp> sceneProps = new();
    private string newPropName = string.Empty;
    private PropCategory newPropCategory = PropCategory.Props;
    private int newPropQuantity = 1;
    private QuillEditor? actionEditor;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool canEdit = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var currentUserId = AuthService.CurrentUser?.Id ?? 0;
        canEdit = await ShareService.CanUserEditProjectAsync(ProjectId, currentUserId);

        if (!canEdit && !SceneId.HasValue)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/scenes");
            return;
        }

        allProjectCharacters = await CharacterService.GetCharactersByProjectIdAsync(ProjectId);

        if (SceneId.HasValue)
        {
            var existingScene = await SceneService.GetSceneByIdAsync(SceneId.Value);
            if (existingScene != null)
            {
                scene = existingScene;
                selectedCharacterIds = new HashSet<int>(scene.SceneCharacters.Select(sc => sc.CharacterId));
                sceneProps = scene.SceneProps.Select(sp => new SceneProp
                {
                    Id = sp.Id,
                    SceneId = sp.SceneId,
                    Name = sp.Name,
                    Category = sp.Category,
                    Quantity = sp.Quantity,
                    Notes = sp.Notes
                }).ToList();
            }
        }
        else
        {
            var initialAct = MovieAct.Act1;
            if (!string.IsNullOrEmpty(targetAct) && Enum.TryParse<MovieAct>(targetAct, true, out var parsedAct))
            {
                initialAct = parsedAct;
            }

            scene = new Scene
                {
                    MovieProjectId = ProjectId,
                    LocationType = LocationType.INT,
                    TimeOfDay = TimeOfDay.Day,
                    Act = initialAct
                };
        }

        isLoading = false;
    }

    private void OnCharacterCheckboxChanged(int characterId, object? isChecked)
    {
        if (!canEdit) return;

        if (isChecked is bool selected && selected)
        {
            selectedCharacterIds.Add(characterId);
        }
        else
        {
            selectedCharacterIds.Remove(characterId);
        }
    }

    private void AddProp()
    {
        if (!canEdit || string.IsNullOrWhiteSpace(newPropName)) return;

        sceneProps.Add(new SceneProp
        {
            Name = newPropName.Trim(),
            Category = newPropCategory,
            Quantity = newPropQuantity < 1 ? 1 : newPropQuantity
        });

        newPropName = string.Empty;
        newPropQuantity = 1;
    }

    private void RemoveProp(SceneProp prop)
    {
        if (!canEdit) return;
        sceneProps.Remove(prop);
    }

    private void HandlePropKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddProp();
        }
    }

    private async Task SaveScene()
    {
        if (!canEdit) return;

        isSaving = true;

        if (actionEditor != null)
        {
            scene.ActionDescription = await actionEditor.GetContentAsync();
        }

        if (scene.Id == 0 && insertAfterNumber.HasValue)
        {
            var created = await SceneService.InsertSceneAfterAsync(ProjectId, insertAfterNumber.Value, scene);
            if (selectedCharacterIds.Any())
            {
                await SceneService.UpdateSceneCharactersAsync(created.Id, selectedCharacterIds.ToList());
            }
            if (sceneProps.Any())
            {
                await SceneService.UpdateScenePropsAsync(created.Id, sceneProps);
            }
        }
        else
        {
            await SceneService.SaveSceneFullAsync(scene, selectedCharacterIds.ToList(), sceneProps);
        }

        isSaving = false;
        GoBack();
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/scenes");
    }
}