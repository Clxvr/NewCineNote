@page "/projects/{ProjectId:int}/scenes/new"
@page "/projects/{ProjectId:int}/scenes/{SceneId:int}/edit"
@layout ProjectLayout
@using CineNote.Models
@using CineNote.Services
@inject SceneService SceneService
@inject CharacterService CharacterService
@inject NavigationManager Navigation

<div class="d-flex flex-column h-100">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <h3 class="fw-bold text-dark mb-0">@(SceneId.HasValue ? $"Сцена {scene.SceneNumber}: {scene.DisplayTitle}" : (insertAfterNumber.HasValue ? $"Вставка сцены после №{insertAfterNumber}" : "Новая сцена"))</h3>
                <p class="text-muted small mb-0">Полноэкранный сценарный редактор</p>
            </div>
        </div>
        <button class="btn btn-warning rounded-3 px-4 py-2 fw-semibold text-dark shadow-sm" @onclick="SaveScene" disabled="@isSaving">
            <i class="bi bi-check-lg me-1"></i> @(isSaving ? "Сохранение..." : "Сохранить и выйти")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Название сцены (необязательно)</label>
                        <InputText @bind-Value="scene.Title" class="form-control border-0 shadow-sm rounded-3" placeholder="Например: Знакомство в кафе или Побег через крышу" />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">ИНТ/НАТ</label>
                            <InputSelect @bind-Value="scene.LocationType" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (LocationType loc in Enum.GetValues(typeof(LocationType)))
                                {
                                    <option value="@loc">@loc.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Объект (Локация)</label>
                            <InputText @bind-Value="scene.LocationName" class="form-control border-0 shadow-sm rounded-3 text-uppercase" placeholder="КВАРТИРА ГЕРОЯ" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">Время суток</label>
                            <InputSelect @bind-Value="scene.TimeOfDay" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (TimeOfDay time in Enum.GetValues(typeof(TimeOfDay)))
                                {
                                    <option value="@time">@time.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">
                                <i class="bi bi-folder2 me-1 text-warning"></i>Акт сценария
                            </label>
                            <InputSelect @bind-Value="scene.Act" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (MovieAct act in Enum.GetValues(typeof(MovieAct)))
                                {
                                    <option value="@act">@act.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">
                                <i class="bi bi-hourglass-split me-1 text-warning"></i>Статус готовности
                            </label>
                            <InputSelect @bind-Value="scene.Status" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (SceneStatus status in Enum.GetValues(typeof(SceneStatus)))
                                {
                                    <option value="@status">@status.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">
                                <i class="bi bi-diagram-3 me-1 text-warning"></i>Поворотная точка
                            </label>
                            <InputSelect @bind-Value="scene.DramaticStructure" class="form-select border-0 shadow-sm rounded-3">
                                @foreach (DramaticStructure marker in Enum.GetValues(typeof(DramaticStructure)))
                                {
                                    <option value="@marker">@marker.ToDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 bg-white flex-grow-1 d-flex flex-column overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold text-dark m-0">Описание действия и диалоги</h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <QuillEditor @ref="actionEditor" InitialHtml="@scene.ActionDescription" MinHeight="400px" />
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h5 class="fw-bold text-dark mb-3">Участники сцены</h5>
                    <p class="text-muted small mb-3">Выберите персонажей, которые присутствуют в этой сцене:</p>

                    @if (!allProjectCharacters.Any())
                    {
                        <div class="text-center py-4 text-muted small border rounded-3 p-3 bg-light">
                            В проекте пока нет ни одного героя. Сначала добавьте их на вкладке «Персонажи».
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 450px;">
                            @foreach (var character in allProjectCharacters)
                            {
                                <div class="form-check p-3 border rounded-3 bg-light d-flex align-items-center gap-2 m-0">
                                    <input class="form-check-input ms-0" type="checkbox"
                                           id="char-@character.Id"
                                           checked="@selectedCharacterIds.Contains(character.Id)"
                                           @onchange="(e) => OnCharacterCheckboxChanged(character.Id, e.Value)" />
                                    <label class="form-check-label fw-semibold text-dark w-100 cursor-pointer" for="char-@character.Id">
                                        @character.Name <span class="text-muted small fw-normal ms-1">(@character.Role.ToDisplayName())</span>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int? SceneId { get; set; }
    [SupplyParameterFromQuery(Name = "after")] public int? insertAfterNumber { get; set; }
    [SupplyParameterFromQuery(Name = "act")] public string? targetAct { get; set; }

    private Scene scene = new();
    private List<Character> allProjectCharacters = new();
    private HashSet<int> selectedCharacterIds = new();
    private QuillEditor? actionEditor;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        allProjectCharacters = await CharacterService.GetCharactersByProjectIdAsync(ProjectId);

        if (SceneId.HasValue)
        {
            var existingScene = await SceneService.GetSceneByIdAsync(SceneId.Value);
            if (existingScene != null)
            {
                scene = existingScene;
                selectedCharacterIds = new HashSet<int>(scene.SceneCharacters.Select(sc => sc.CharacterId));
            }
        }
        else
        {
            var initialAct = MovieAct.Act1;
            if (!string.IsNullOrEmpty(targetAct) && Enum.TryParse<MovieAct>(targetAct, true, out var parsedAct))
            {
                initialAct = parsedAct;
            }

            scene = new Scene
                {
                    MovieProjectId = ProjectId,
                    LocationType = LocationType.INT,
                    TimeOfDay = TimeOfDay.Day,
                    Act = initialAct
                };
        }

        isLoading = false;
    }

    private void OnCharacterCheckboxChanged(int characterId, object? isChecked)
    {
        if (isChecked is bool selected && selected)
        {
            selectedCharacterIds.Add(characterId);
        }
        else
        {
            selectedCharacterIds.Remove(characterId);
        }
    }

    private async Task SaveScene()
    {
        isSaving = true;

        if (actionEditor != null)
        {
            scene.ActionDescription = await actionEditor.GetContentAsync();
        }

        if (scene.Id == 0 && insertAfterNumber.HasValue)
        {
            var created = await SceneService.InsertSceneAfterAsync(ProjectId, insertAfterNumber.Value, scene);
            if (selectedCharacterIds.Any())
            {
                await SceneService.UpdateSceneCharactersAsync(created.Id, selectedCharacterIds.ToList());
            }
        }
        else
        {
            await SceneService.SaveSceneWithCharactersAsync(scene, selectedCharacterIds.ToList());
        }

        isSaving = false;
        GoBack();
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/scenes");
    }
}