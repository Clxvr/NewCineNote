@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="bg-white">
    <div @ref="editorElement" style="min-height: @MinHeight;"></div>
</div>

@code {
    [Parameter] public string InitialHtml { get; set; } = string.Empty;
    [Parameter] public string MinHeight { get; set; } = "250px";

    private ElementReference editorElement;
    private IJSObjectReference? jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/synopsisEditor.js?v=2");
            await jsModule.InvokeVoidAsync("initializeEditor", editorElement, InitialHtml);
        }
    }

    public async Task<string> GetContentAsync()
    {
        if (jsModule != null)
        {
            return await jsModule.InvokeAsync<string>("getContent", editorElement);
        }
        return InitialHtml;
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            try { await jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}