@page "/projects"
@using CineNote.Models
@using CineNote.Services
@inject MovieProjectService ProjectService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-4 projects-container">
    @if (!AuthService.IsLoggedIn || AuthService.CurrentUser == null)
    {
        <div class="alert alert-warning shadow-sm p-4">
            <h4>Требуется авторизация</h4>
            <p class="mb-3">Для просмотра ваших сценариев необходимо войти в систему.</p>
            <a href="/login" class="btn btn-primary">Войти в аккаунт</a>
        </div>
    }
    else
    {
        <!-- Панель информации о текущем пользователе -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 user-greeting">
            <div class="mb-2 mb-md-0">
                <span class="text-muted">👤 Вы вошли как: </span>
                <strong class="text-dark">@AuthService.CurrentUser.Name</strong>
                <span class="text-muted ms-1">(@AuthService.CurrentUser.Email)</span>
            </div>
            <button class="btn btn-outline-danger btn-sm px-3" @onclick="Logout">Выйти</button>
        </div>

        <!-- Шапка страницы с заголовком и кнопкой создания -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Мои проекты</h2>
            <a href="/projects/create" class="btn btn-primary">+ Новый проект</a>
        </div>

        @if (userProjects == null)
        {
            <div class="text-center py-5">
                <p class="text-muted">Загрузка ваших проектов...</p>
            </div>
        }
        else if (!userProjects.Any())
        {
            <div class="alert alert-info shadow-sm p-4">
                <h5>У вас пока нет проектов</h5>
                <p class="mb-0">Создайте свой первый кинопроект или сценарий с помощью кнопки выше!</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var project in userProjects)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card p-4 h-100 d-flex flex-column">
                            <h5 class="card-title mb-2">@project.Title</h5>
                            <p class="card-text text-muted flex-grow-1">
                                @(string.IsNullOrEmpty(project.Logline) ? "Описание отсутствует..." : project.Logline)
                            </p>

                            <!-- Кнопки управления проектом -->
                            <div class="mt-3 d-flex gap-2">
                                <a href="/projects/@project.Id" class="btn btn-outline-primary btn-sm flex-grow-1">Открыть</a>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteProject(project.Id)">Удалить</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<MovieProject>? userProjects;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        if (AuthService.IsLoggedIn && AuthService.CurrentUser != null)
        {
            userProjects = await ProjectService.GetProjectsByUserIdAsync(AuthService.CurrentUser.Id);
        }
    }

    private async Task DeleteProject(int id)
    {
      if (AuthService.CurrentUser == null) return;

        bool success = await ProjectService.DeleteProjectAsync(id, AuthService.CurrentUser.Id);

        if (success)
        {
            // Перезагружаем список проектов, чтобы карточка пропала с экрана
            await LoadProjects();
        }
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}