@page "/projects"
@using CineNote.Models
@using CineNote.Services
@inject MovieProjectService ProjectService
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Мои кинопроекты</h2>
        <button class="btn btn-success" @onclick="OpenCreateModal">➕ Новый проект</button>
    </div>

    @if (projects == null)
    {
        <p class="text-muted">Загрузка проектов...</p>
    }
    else if (!projects.Any())
    {
        <div class="alert alert-info">
            У вас пока нет созданных кинопроектов. Нажмите кнопку «Новый проект», чтобы начать!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var project in projects)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary">@project.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">Жанр: @project.Genre</h6>
                            <p class="card-text text-truncate flex-grow-1">@project.Logline</p>
                            <button class="btn btn-outline-primary btn-sm mt-auto" @onclick="() => ViewProject(project.Id)">
                                Открыть сценарий ➡️
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (isCreating)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Создание нового кинопроекта</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@newProject" OnValidSubmit="HandleCreateProject">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="mb-3">
                                <label class="form-label">Название проекта:</label>
                                <InputText @bind-Value="newProject.Title" class="form-control" placeholder="Например: Побег из комнаты" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Жанр:</label>
                                <InputSelect @bind-Value="newProject.Genre" class="form-select">
                                    @foreach (Genre genre in Enum.GetValues(typeof(Genre)))
                                    {
                                        <option value="@genre">@genre</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Логлайн (краткое описание в 1-2 предложения):</label>
                                <InputTextArea @bind-Value="newProject.Logline" class="form-control" rows="2" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Синопсис:</label>
                                <InputTextArea @bind-Value="newProject.Synopsis" class="form-control" rows="4" />
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                                <button type="submit" class="btn btn-primary">Создать проект</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MovieProject>? projects;
    private bool isCreating = false;
    private MovieProject newProject = new();

    // Временный ID пользователя для тестов (позже привяжем к системе авторизации)
    private int currentUserId = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        // Если в базе еще нет пользователей с id = 1, временно добавим тестового, чтобы не было ошибок FK
        projects = await ProjectService.GetProjectsByUserIdAsync(currentUserId);
    }

    private void OpenCreateModal()
    {
        newProject = new MovieProject { UserId = currentUserId };
        isCreating = true;
    }

    private void CloseModal()
    {
        isCreating = false;
    }

    private async Task HandleCreateProject()
    {
        await ProjectService.CreateProjectAsync(newProject);
        isCreating = false;
        await LoadProjects();
    }

    private void ViewProject(int projectId)
    {
        // Сюда перенаправим на страницу редактора сцен и персонажей проекта
        Navigation.NavigateTo($"/project/{projectId}");
    }
}