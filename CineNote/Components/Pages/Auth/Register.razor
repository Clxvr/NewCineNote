@page "/register"
@rendermode InteractiveServer
@using CineNote.Models
@using CineNote.Services
@inject UserService UserService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject EmailService EmailService

<div class="container mt-5 register-container" style="max-width: 450px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="text-center fw-bold mb-4" style="color: #1F2937;">Регистрация в CineNote</h3>

        <EditForm EditContext="@editContext" OnSubmit="HandleRegistration">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-semibold">Имя:</label>
                <InputText @bind-Value="newUser.Name" class="form-control" placeholder="Ваше имя" />
                <div style="min-height: 22px;" class="mt-1">
                    @if (isSubmitted)
                    {
                        <div class="text-danger small">
                            <ValidationMessage For="@(() => newUser.Name)" />
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email:</label>
                <InputText @bind-Value="newUser.Email" class="form-control" placeholder="example@mail.com" />
                <div style="min-height: 22px;" class="mt-1">
                    @if (isSubmitted)
                    {
                        <div class="text-danger small">
                            <ValidationMessage For="@(() => newUser.Email)" />
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Пароль:</label>
                <div class="input-group">
                    <InputText @bind-Value="newUser.Password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Пароль" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                        @(showPassword ? "Скрыть" : "Показать")
                    </button>
                </div>
                <div style="min-height: 38px;" class="mt-1">
                    @if (isSubmitted)
                    {
                        <div class="text-danger small">
                            <ValidationMessage For="@(() => newUser.Password)" />
                        </div>
                    }
                </div>
                <div class="form-text text-muted" style="font-size: 0.75rem;">
                    Мин. 8 символов, заглавная буква и цифра.
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 small mb-3">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success py-2 small mb-3">@successMessage</div>
            }

            <button type="submit" class="btn w-100 py-2 fw-semibold mb-3 shadow-sm" style="background-color: #F59E0B; border: none; color: #fff;">
                Зарегистрироваться
            </button>

            <div class="text-center small text-muted">
                Уже есть аккаунт? <a href="/login" class="text-decoration-none fw-semibold" style="color: #D97706;">Войти</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private User newUser = new();
    private EditContext? editContext;
    private bool isSubmitted = false;
    private string? errorMessage;
    private string? successMessage;
    private bool showPassword = false;

    protected override void OnInitialized()
    {
        editContext = new(newUser);
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleRegistration()
    {
        isSubmitted = true;
        errorMessage = null;
        successMessage = null;

        if (editContext == null || !editContext.Validate())
        {
            return;
        }

        try
        {
            var existingUser = await UserService.GetUserByEmailAsync(newUser.Email);
            if (existingUser != null)
            {
                errorMessage = "Пользователь с таким email уже зарегистрирован!";
                return;
            }

            string code = new Random().Next(100000, 999999).ToString();
            newUser.VerificationCode = code;
            newUser.IsEmailConfirmed = false;

            var plainPassword = newUser.Password;
            var hashed = BCrypt.Net.BCrypt.HashPassword(plainPassword);
            newUser.Password = hashed;

            await UserService.AddUserAsync(newUser);

            var mskTime = DateTime.UtcNow.AddHours(3);
            string subject = "Подтверждение регистрации учетной записи | CineNote";
            string htmlMessage = $@"
                <div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 30px; border: 1px solid #e5e7eb; border-radius: 12px; background-color: #ffffff;'>
                    <div style='border-bottom: 2px solid #F59E0B; padding-bottom: 20px; margin-bottom: 25px;'>
                        <h2 style='color: #111827; margin: 0; font-size: 22px; font-weight: 700;'>🎬 CineNote</h2>
                        <span style='color: #6b7280; font-size: 13px;'>Платформа для сценаристов и режиссеров</span>
                    </div>

                    <h3 style='color: #1f2937; margin-top: 0; font-size: 18px;'>Здравствуйте, {newUser.Name}!</h3>
                    <p style='color: #4b5563; line-height: 1.6; font-size: 15px; margin-bottom: 25px;'>
                        Благодарим вас за регистрацию в сервисе <strong>CineNote</strong>. 
                        Для завершения создания учетной записи и активации аккаунта введите одноразовый код подтверждения:
                    </p>

                    <div style='text-align: center; margin: 30px 0;'>
                        <div style='display: inline-block; background-color: #fef3c7; border: 2px dashed #f59e0b; padding: 16px 36px; border-radius: 10px;'>
                            <span style='font-size: 32px; font-weight: 800; letter-spacing: 8px; color: #92400e; font-family: Consolas, monospace;'>{code}</span>
                        </div>
                        <span style='display: block; margin-top: 10px; color: #9ca3af; font-size: 13px;'>Код действителен в течение текущей сессии регистрации</span>
                    </div>

                    <div style='background-color: #f9fafb; border-left: 4px solid #f59e0b; padding: 14px 18px; border-radius: 0 8px 8px 0; margin-bottom: 25px;'>
                        <p style='margin: 0; color: #4b5563; font-size: 13px; line-height: 1.5;'>
                            <strong>Безопасность:</strong> Если вы не регистрировались на платформе CineNote, проигнорируйте данное сообщение. Никому не сообщайте полученный код.
                        </p>
                    </div>

                    <div style='border-top: 1px solid #f3f4f6; padding-top: 20px; text-align: center; color: #9ca3af; font-size: 12px;'>
                        <p style='margin: 0 0 5px 0;'>Отправлено: {mskTime:dd.MM.yyyy HH:mm} (МСК)</p>
                        <p style='margin: 0;'>&copy; 2026 CineNote. Все права защищены.</p>
                    </div>
                </div>";

            await EmailService.SendEmailAsync(newUser.Email, subject, htmlMessage);

            successMessage = "Код отправлен на почту! Перенаправление...";
            await Task.Delay(1500);

            Navigation.NavigateTo($"/verify-email?email={newUser.Email}");
        }
        catch (Exception ex)
        {
            errorMessage = "Ошибка при регистрации: " + ex.Message;
        }
    }
}
