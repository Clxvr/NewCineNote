@page "/register"
@using CineNote.Models
@using CineNote.Services
@inject UserService UserService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject EmailService EmailService
<div class="container mt-5 register-container">
    <div class="card shadow-sm p-4">
        <h3 class="text-center mb-4">Регистрация в CineNote</h3>

        <EditForm Model="@newUser" OnValidSubmit="HandleRegistration">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Имя:</label>
                <InputText @bind-Value="newUser.Name" class="form-control" placeholder="Ваше имя" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email:</label>
                <InputText @bind-Value="newUser.Email" class="form-control" placeholder="example@mail.com" />
            </div>

            <div class="mb-3">
                <label class="form-label">Пароль:</label>
                <div class="input-group">
                    <InputText @bind-Value="newUser.Password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Пароль" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                        @(showPassword ? "Скрыть" : "Показать")
                    </button>
                </div>
                <div class="form-text text-muted" style="font-size: 0.75rem;">
                    Мин. 8 символов, заглавная и строчная буквы, цифра и спецсимвол.
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success py-2">@successMessage</div>
            }

            <button type="submit" class="btn btn-primary w-100 mb-3">Зарегистрироваться</button>

            <div class="text-center">
                <span class="text-muted">Уже есть аккаунт? </span>
                <a href="/login">Войти</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private User newUser = new();
    private string? errorMessage;
    private string? successMessage;
    private bool showPassword = false;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleRegistration()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var existingUser = await UserService.GetUserByEmailAsync(newUser.Email);
            if (existingUser != null)
            {
                errorMessage = "Пользователь с таким email уже зарегистрирован!";
                return;
            }

        
            string code = new Random().Next(100000, 999999).ToString();
            newUser.VerificationCode = code;
            newUser.IsEmailConfirmed = false;

    
            newUser.Password = BCrypt.Net.BCrypt.HashPassword(newUser.Password);
            await UserService.AddUserAsync(newUser);

   
            string subject = "Код подтверждения регистрации CineNote";
            string htmlMessage = $"<h2>Добро пожаловать, {newUser.Name}!</h2>" +
                                 $"<p>Ваш код подтверждения для завершения регистрации:</p>" +
                                 $"<h1 style='color: #4CAF50; letter-spacing: 2px;'>{code}</h1>";

            await EmailService.SendEmailAsync(newUser.Email, subject, htmlMessage);

            successMessage = "Код отправлен на почту! Перенаправление...";
            await Task.Delay(1500);

        
            Navigation.NavigateTo($"/verify-email?email={newUser.Email}");
        }
        catch (Exception ex)
        {
            errorMessage = "Ошибка при регистрации: " + ex.Message;
        }
    }
}